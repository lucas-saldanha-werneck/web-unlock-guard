{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|mcp__.*ctx_(batch_)?execute(_file)?",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"], "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|WebFetch|mcp__.*ctx_(batch_)?execute(_file)?",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"], "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|WebFetch|mcp__.*ctx_(batch_)?execute(_file)?",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"], "timeout": 5 }
        ]
      }
    ]
  }
}
